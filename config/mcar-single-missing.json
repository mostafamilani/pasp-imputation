{
  "experiment": "mcar-single-missing",
  "sampling_seeds": {"complete_data": 8, "missingness": 58},
  "relation": {
    "name": "person",
    "attributes": [
      {"name": "id", "type": "integer"},
      {"name": "group", "type": "categorical", "domain": ["a", "b"]},
      {"name": "disease", "type": "categorical", "domain": ["yes", "no"], "may_be_missing": true}
    ],
    "key": ["id"]
  },
  "dataset": {
    "source": "synthetic",
    "number_of_records": 6
  },
  "generation": {
    "model": "bayesian_network",
    "nodes": [
      {"name": "group", "parents": [], "distribution": {"a": 0.5, "b": 0.5}},
      {
        "name": "disease",
        "parents": ["group"],
        "conditional_distribution": {
          "group=a": {"yes": 0.7, "no": 0.3},
          "group=b": {"yes": 0.2, "no": 0.8}
        }
      }
    ],
    "rows_by_group": {"a": 3, "b": 3},
    "disease_given_group": {
      "a": {"yes": 0.7, "no": 0.3},
      "b": {"yes": 0.2, "no": 0.8}
    }
  },
  "missingness": {
    "missing_token": "na",
    "nodes": [
      {
        "name": "missing_disease",
        "attribute": "disease",
        "parents": [],
        "distribution": {"missing": 0.35, "observed": 0.65}
      }
    ]
  },
  "files": {
    "complete": "data/mcar-single-missing/complete.csv",
    "observed": "data/mcar-single-missing/observed.csv",
    "missingness_mask": "data/mcar-single-missing/missingness-mask.csv",
    "blocks": "data/mcar-single-missing/blocks.csv"
  }
}
